# Supabase Edge Function secret'ları (YEREL çalıştırma için örnek).
# Bu dosya repoya GİRER — içine GERÇEK anahtar yazmayın.
# Gerçek değerler `supabase/.env` dosyasına konur; `.env` deseni `.gitignore`'da
# tanımlıdır (bkz. .gitignore: `.env`, `.env.*`, `!.env.example`).

# --- AI (Pollinations / OpenAI uyumlu) ---------------------------------------
OPENAI_API_KEY="dummy-key"
OPENAI_BASE_URL="https://gen.pollinations.ai/v1"
OPENAI_MODEL="openai"

# --- Bildirim ---------------------------------------------------------------
RESEND_API_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Sunucu içi (internal) çağrı token'ı -----------------------------------
# check-reminders -> send-notification akışı bu token ile yetkilendirilir.
# Supabase dashboard cron'u JWT'siz çağırıyor olduğu için ÜRETİMDE ZORUNLUDUR.
# Değer ÜRETİMDE tanımlanmazsa check-reminders yalnızca service_role JWT'si
# veya `x-calorix-internal: 1` başlığı ile yetkilendirilir.
# Üretmek için: `openssl rand -hex 32`
INTERNAL_FUNCTION_TOKEN=""
