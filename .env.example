# Supabase Configuration
# For hosted Supabase, use your project URL.
# For Docker development with the local Supabase stack, use http://localhost:54321.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Docker / Local Supabase Configuration (development only)
# Required when running the Supabase CLI inside Docker so bind mounts resolve on the host.
PROJECT_ROOT="/CaloriX-v2"
SUPABASE_ACCESS_TOKEN=""

# AI Configuration (Pollinations AI - Free)
OPENAI_API_KEY="dummy-key"
OPENAI_BASE_URL="https://gen.pollinations.ai/v1"
OPENAI_MODEL="openai"

# Notification Configuration (Optional)
RESEND_API_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Sunucu tarafı secret'lar (Edge Functions)
# ---------------------------------------------------------------------------
# Bu değişkenler React istemcisine GÖNDERİLMEZ (VITE_ öneki taşımazlar).
# Edge function'lar `Deno.env.get(...)` ile okur; gerçek değerler Supabase
# projesinde `supabase secrets set` ile tanımlanır. Tam liste ve üretim
# talimatı: `supabase/.env.example`.
#
# INTERNAL_FUNCTION_TOKEN
#   `check-reminders` -> `send-notification` akışının yetkilendirilmesi.
#   Supabase dashboard cron'u JWT'SİZ çağırır (supabase/config.toml:
#   `verify_jwt = false`), bu yüzden üretimde tanımlanmadığı takdirde o
#   akış yalnızca service_role JWT'siyle çalışır ve tüm hatırlatıcılar
#   sessizce gitmez. Üretim: `openssl rand -hex 32`
INTERNAL_FUNCTION_TOKEN=""

# VAPID_SUBJECT
#   Web Push (RFC 8291/8292) için abonelik "subject" alanı. Yalnız
#   `mailto:` ya da `https://` biçimi kabul edilir; aksi hâlde push
#   servisi isteği reddeder. Üretim: "mailto:ops@calorix.app"
VAPID_SUBJECT=""

# NOT: `VAPID_PRIVATE_KEY` yukarıda tanımlı. Web Push için `VAPID_SUBJECT`
# de zorunludur; ikisi birlikte tanımlanmazsa bildirimler üretilmez.
